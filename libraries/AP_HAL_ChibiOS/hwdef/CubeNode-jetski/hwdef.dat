include ../CubeNode/hwdef.inc

# CAN2
PB5     CAN2_RX     CAN2
PB6     CAN2_TX     CAN2

# UART8
PE1 UART8_TX UART8
PE0 UART8_RX UART8

# CONSOLE TELEM1 TELEM2 GPS1 GPS2 SLCAN
undef SERIAL_ORDER
SERIAL_ORDER OTG1 UART8 UART7 EMPTY EMPTY OTG2

I2C_ORDER I2C1

PB8 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

# GPIO AND TIMER
PE9 TIM1_CH1 TIM1 PWM(1) GPIO(50)   # step
PD12 TIM4_CH1 TIM4 PWM(2) GPIO(51)  # GPIO
PD15 TIM4_CH4 TIM4 PWM(3) GPIO(52)  # Throttle
# PC8 TIM8_CH3 TIM8 PWM(4) GPIO(53) # GPIO
PC9 TIM8_CH4 TIM8 PWM(5) GPIO(53)   # GPIO

PE11 TIM1_CH2 TIM1 PWM(6) GPIO(54)  # dir
PE13 TIM1_CH3 TIM1 PWM(7) GPIO(55)  # EN
PD13 TIM4_CH2 TIM4 PWM(8) GPIO(56)  # SSS INBND (HANDLE BUTTON)
PD14 TIM4_CH3 TIM4 PWM(9) GPIO(57)  # SSS OUTBND (TO JETSKI ECU)

# ADC's
PC0  THROTTLE_FULLSCALE ADC1 SCALE(1) ANALOG(2)
PA4  THROTTLE_HALFSCALE ADC1 SCALE(1) ANALOG(3)
PA5  BRAKE_FULLSCALE    ADC1 SCALE(1) ANALOG(4)
PF14 BRAKE_HALFSCALE    ADC2 SCALE(1) ANALOG(5) # Should be PF4 (ADC3) but was routed to PF14 (ADC2) by mistake.
PC3  ANALOG_IN_1        ADC3 SCALE(1) ANALOG(6)
PF5  ANALOG_IN_2        ADC3 SCALE(1) ANALOG(7)
PF3  ANALOG_IN_3        ADC3 SCALE(1) ANALOG(8)
PF12 ANALOG_IN_4        ADC1 SCALE(1) ANALOG(9)

define HAL_BARO_ALLOW_INIT_NO_BARO
define AP_BARO_ENABLED 0
define AP_BARO_BACKEND_DEFAULT_ENABLED 0

PC8 TIM3_CH3 TIM3 RCININT PULLDOWN LOW

PA10 STEPPER_DRIVER_CS CS
SPIDEV drv8462  SPI3  DEVID1  STEPPER_DRIVER_CS   MODE1  10*MHZ  10*MHZ

undef IMU
IMU Invensensev3 SPI:icm45686 ROTATION_PITCH_180_YAW_90