-- This script scans for devices on the i2c bus

---@diagnostic disable: need-check-nil

local address = 0
local found = 0

local i2c_bus = i2c:get_device(0,0)
i2c_bus:set_retries(10)

function update() -- this is the loop which periodically runs

  i2c_bus:set_address(54)

  if i2c_bus:read_registers(0) then
      gcs:send_text(0, "Found I2C at " .. tostring(54))
  else
      gcs:send_text(0, "No device at " .. tostring(54))
  end

  return update, 50 -- reschedules the loop
end

return update() -- run immediately before starting to reschedule
