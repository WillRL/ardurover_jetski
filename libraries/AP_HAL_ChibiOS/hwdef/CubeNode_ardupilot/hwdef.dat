# hw definition file for processing by chibios_hwdef.py
# for H757
# USB setup

# MCU class and specific type
MCU STM32H7xx STM32H757xx

define CORE_CM7
define SMPS_PWR
# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID AP_HW_CUBENODE

FLASH_SIZE_KB 2048
define BAR
# the location where the bootloader will put the firmware
# the H757 has 128k sectors, assign 2 sectors for BL
FLASH_BOOTLOADER_LOAD_KB    256
FLASH_RESERVE_START_KB  256

# crystal frequency
OSCILLATOR_HZ 24000000

# CAN1
PD0     CAN1_RX     CAN1
PD1     CAN1_TX     CAN1

# CAN2
PB5     CAN2_RX     CAN2
PB6     CAN2_TX     CAN2

# USB
PA11    OTG_FS_DM   OTG1
PA12    OTG_FS_DP   OTG1

# SERIAL
PE7 UART7_RX UART7
PE8 UART7_TX UART7

# UART8
PE1 UART8_TX UART8
PE0 UART8_RX UART8

SERIAL_ORDER OTG1 UART7 UART8

# CAN Common
PG1 SLEEPCAN OUTPUT PUSHPULL SPEED_LOW LOW 
PG0 SHUTDOWNCAN OUTPUT PUSHPULL SPEED_LOW LOW

# These are the pins for SWD debugging with a STlinkv2 or black-magic probe.
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD


STORAGE_FLASH_PAGE 14
define HAL_STORAGE_SIZE 32768

# Ethernet
PC1  ETH_MDC            ETH1
PA2  ETH_MDIO           ETH1
PC4  ETH_RMII_RXD0      ETH1
PC5  ETH_RMII_RXD1      ETH1
PB12 ETH_RMII_TXD0      ETH1
PB13 ETH_RMII_TXD1      ETH1
PB11 ETH_RMII_TX_EN     ETH1
PA7  ETH_RMII_CRS_DV    ETH1
PA1  ETH_RMII_REF_CLK   ETH1

define BOARD_PHY_ID  MII_LAN8720_ID
define BOARD_PHY_RMII

# IMU
PC10 SPI3_SCK SPI3
PC11 SPI3_MISO SPI3
PC12 SPI3_MOSI SPI3
PG15 IMU_CS CS

SPIDEV icm45686  SPI3  DEVID4  IMU_CS   MODE0  24*MHZ  24*MHZ

IMU Invensensev3 SPI:icm45686 ROTATION_PITCH_180_YAW_90

I2C_ORDER I2C1

PB8 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

# GPIO AND TIMER
# GPIO50-52 is used for stepper step, dir and en respectively.
PE13 TIM1_CH3 TIM1 PWM(1) GPIO(50)
PE11 TIM1_CH2 TIM1 PWM(2) GPIO(51)
PE9 TIM1_CH1 TIM1 PWM(3) GPIO(52)

# GPIO pins
PD12 TIM4_CH1 TIM4 PWM(4) GPIO(53)
PD15 TIM4_CH4 TIM4 PWM(5) GPIO(54)
PC8 TIM8_CH3 TIM8 PWM(6) GPIO(55)
PC9 TIM8_CH4 TIM8 PWM(7) GPIO(56)


# ADC's
PC0  ADC1 ADC1 SCALE(1)
PA4  ADC2 ADC1 SCALE(1)
PA5  ADC3 ADC1 SCALE(1)
PF4  ADC4 ADC3 SCALE(1)
PC3  ADC5 ADC3 SCALE(1)
PF5  ADC6 ADC3 SCALE(1)
PF3  ADC7 ADC3 SCALE(1)
PF12 ADC8 ADC1 SCALE(1)

define HAL_BARO_ALLOW_INIT_NO_BARO
define AP_BARO_ENABLED 0
define AP_BARO_BACKEND_DEFAULT_ENABLED 0

PC7 TIM3_CH2 TIM3 RCININT PULLDOWN LOW
